{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "packages/design-system/src/generated/appearance-init.js",
    // Nested accidental checkout; not the active parent worktree.
    "progressive-adaptive-vue-platform/**",
  ],
  "workspaces": {
    "apps/web": {
      "entry": [
        "src/shared/api/index.ts",
        "src/shared/query/index.ts",
        "src/shared/table/index.ts",
        "src/shared/i18n/index.ts",
        "src/app/router/router-console-projection.ts",
        "src/app/workspace/workspace-content.ts",
        "src/app/forms/use-guarded-form.ts",
        "src/app/tables/use-guarded-table.ts",
        "src/app/tables/guarded-table-editor.ts",
      ],
    },
  },
}
