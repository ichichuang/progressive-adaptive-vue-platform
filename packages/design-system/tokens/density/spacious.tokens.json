{
  "density": {
    "spacious": {
      "control": {
        "height": {
          "$type": "dimension",
          "$value": "{dimension.control.xl}"
        },
        "padding-inline": {
          "$type": "dimension",
          "$value": "{dimension.space.4}"
        },
        "height-small": {
          "$type": "dimension",
          "$value": "{dimension.control.intermediate}"
        },
        "height-large": {
          "$type": "dimension",
          "$value": "{dimension.control.xxl}"
        }
      },
      "button": {
        "padding-inline": {
          "$type": "dimension",
          "$value": "{dimension.space.button-inline-spacious}"
        }
      },
      "section": {
        "gap": {
          "$type": "dimension",
          "$value": "{dimension.space.8}"
        }
      },
      "content": {
        "gap": {
          "$type": "dimension",
          "$value": "{dimension.space.4}"
        }
      },
      "field": {
        "gap": {
          "$type": "dimension",
          "$value": "{dimension.space.6}"
        }
      },
      "panel": {
        "padding": {
          "$type": "dimension",
          "$value": "{dimension.space.8}"
