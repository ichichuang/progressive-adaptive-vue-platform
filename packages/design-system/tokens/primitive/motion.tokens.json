{
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": {
          "value": 120,
          "unit": "ms"
        }
      },
      "normal": {
        "$type": "duration",
        "$value": {
          "value": 200,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [0.2, 0, 0, 1]
      }
    }
  }
}
