{
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["ui-sans-serif", "system-ui", "sans-serif"]
      }
    },
    "size": {
      "body": {
        "$type": "dimension",
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "title": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "rem"
        }
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "line-height": {
      "body": {
        "$type": "number",
        "$value": 1.5
      },
      "title": {
        "$type": "number",
        "$value": 1.2
      }
    }
  }
}
