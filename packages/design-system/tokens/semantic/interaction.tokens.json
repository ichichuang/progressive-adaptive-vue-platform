{
  "interaction": {
    "border": {
      "width": {
        "$type": "dimension",
        "$value": "{dimension.border.width}"
      }
    },
    "control": {
      "segment": {
        "width": {
          "small": {
            "$type": "dimension",
            "$value": "{dimension.control.segment-width-small}"
          },
          "medium": {
            "$type": "dimension",
            "$value": "{dimension.control.segment-width-medium}"
          },
          "large": {
            "$type": "dimension",
            "$value": "{dimension.control.segment-width-large}"
          }
        }
      },
      "height": {
        "$type": "dimension",
        "$value": "{density.comfortable.control.height}"
      },
      "height-compact": {
        "$type": "dimension",
        "$value": "{density.compact.control.height}",
        "$extensions": {
          "org.pavp": {
            "role": "interaction.control.height",
            "conditions": {
              "density": "compact"
            }
          }
        }
      },
      "height-comfortable": {
        "$type": "dimension",
        "$value": "{density.comfortable.control.height}",
        "$extensions": {
          "org.pavp": {
            "role": "interaction.control.height",
            "conditions": {
              "density": "comfortable"
            }
          }
        }
      },
      "height-spacious": {
        "$type": "dimension",
        "$value": "{density.spacious.control.height}",
        "$extensions": {
          "org.pavp": {
            "role": "interaction.control.height",
            "conditions": {
              "density": "spacious"
            }
          }
        }
      },
      "height-baseline": {
        "$type": "dimension",
        "$value": "{dimension.control.md}",
        "$extensions": {
          "org.pavp": {
            "visibility": "ui-internal"
          }
        }
      },
      "height-small": {
        "$type": "dimension",
        "$value": "{density.comfortable.control.height-small}"
      },
      "height-small-compact": {
        "$type": "dimension",
        "$value": "{density.compact.control.height-small}",
        "$extensions": {
          "org.pavp": {
            "role": "interaction.control.height-small",
            "conditions": {
              "density": "compact"
            }
          }
        }
      },
      "height-small-comfortable": {
        "$type": "dimension",
        "$value": "{density.comfortable.control.height-small}",
        "$extensions": {
          "org.pavp": {
            "role": "interaction.control.height-small",
            "conditions": {
              "density": "comfortable"
            }
          }
        }
      },
      "height-small-spacious": {
        "$type": "dimension",
        "$value": "{density.spacious.control.height-small}",
        "$extensions": {
          "org.pavp": {
            "role": "interaction.control.height-small",
            "conditions": {
              "density": "spacious"
            }
          }
        }
      },
      "height-large": {
        "$type": "dimension",
        "$value": "{density.comfortable.control.height-large}"
      },
      "height-large-compact": {
        "$type": "dimension",
        "$value": "{density.compact.control.height-large}",
        "$extensions": {
          "org.pavp": {
            "role": "interaction.control.height-large",
            "conditions": {
              "density": "compact"
            }
          }
        }
      },
      "height-large-comfortable": {
        "$type": "dimension",
        "$value": "{density.comfortable.control.height-large}",
        "$extensions": {
          "org.pavp": {
            "role": "interaction.control.height-large",
            "conditions": {
              "density": "comfortable"
            }
          }
        }
      },
      "height-large-spacious": {
        "$type": "dimension",
        "$value": "{density.spacious.control.height-large}",
        "$extensions": {
          "org.pavp": {
            "role": "interaction.control.height-large",
            "conditions": {
              "density": "spacious"
            }
          }
        }
      }
    },
    "icon": {
      "size": {
        "extra-small": {
          "$type": "dimension",
          "$value": "{dimension.icon.extra-small}"
        },
        "small": {
          "$type": "dimension",
          "$value": "{dimension.icon.small}"
        },
        "medium": {
          "$type": "dimension",
          "$value": "{dimension.icon.medium}"
        },
        "large": {
          "$type": "dimension",
          "$value": "{dimension.icon.large}"
        },
        "extra-large": {
          "$type": "dimension",
          "$value": "{dimension.icon.extra-large}"
        }
      }
    },
    "indicator": {
      "cell": {
        "small": {
          "$type": "dimension",
          "$value": "{dimension.indicator.cell-small}"
        },
        "medium": {
          "$type": "dimension",
          "$value": "{dimension.indicator.cell-medium}"
        },
        "large": {
          "$type": "dimension",
          "$value": "{dimension.indicator.cell-large}"
        }
      },
      "slot": {
        "icon-inline-size": {
          "$type": "dimension",
          "$value": "{dimension.indicator.slot-icon-inline}"
        },
        "text-inline-size": {
          "$type": "dimension",
          "$value": "{dimension.indicator.slot-text-inline}"
        }
      },
      "circle": {
        "size": {
          "$type": "dimension",
          "$value": "{dimension.indicator.circle}"
        },
        "multiple-size": {
          "$type": "dimension",
          "$value": "{dimension.indicator.circle-multiple}"
        }
      },
      "label": {
        "height": {
          "$type": "dimension",
          "$value": "{dimension.indicator.label-height}"
        }
      },
      "rail": {
        "labeled": {
          "$type": "dimension",
          "$value": "{dimension.indicator.rail-labeled}"
        },
        "thin": {
          "$type": "dimension",
          "$value": "{dimension.indicator.rail-thin}"
        },
        "standard": {
          "$type": "dimension",
          "$value": "{dimension.indicator.rail-standard}"
        }
      },
      "marker": {
        "size": {
          "$type": "dimension",
          "$value": "{dimension.indicator.marker}"
        }
      },
      "handle": {
        "size": {
          "$type": "dimension",
          "$value": "{dimension.indicator.handle}"
        }
      }
    },
    "radius": {
      "control": {
        "$type": "dimension",
        "$value": "{radius.control}"
      },
      "panel": {
        "$type": "dimension",
        "$value": "{radius.md}"
      },
      "small": {
        "$type": "dimension",
        "$value": "{radius.sm}",
        "$extensions": {
          "org.pavp": {
            "visibility": "ui-internal"
          }
        }
      }
    },
    "shadow": {
      "panel": {
        "$type": "shadow",
        "$value": "{elevation.panel}"
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "$value": "{motion.duration.normal}"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{motion.easing.standard}"
      }
    }
  }
}
